+        Vstd::NoVstd => "no-vstd",
+        Vstd::Imported => "imported",
+        Vstd::IsCore => "is-core",
+        Vstd::ImportedViaCore => "imported-via-core",
+    };
+    let start = Instant::now();
+    let status = std::process::Command::new(std::env::current_exe().map_err(|_| ())?)
+        .arg(PIPELINED_ERASURE_DRIVER_ARG)
+        .arg(vstd_mode)
+        .args(rustc_args)
+        .status()
+        .map_err(|_| ())?;
+    if status.success() { Ok(start.elapsed()) } else { Err(()) }
+}
